
APP_NAME=VanishLab
ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-super-secret-key-for-production-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=vanishlab
POSTGRES_PASSWORD=vanishlab_password
POSTGRES_DB=vanishlab_db
DATABASE_URL=postgresql+asyncpg://vanishlab:vanishlab_password@postgres:5432/vanishlab_db
DATABASE_URL_SYNC=postgresql://vanishlab:vanishlab_password@postgres:5432/vanishlab_db

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=vanishlab-media
S3_REGION=us-east-1
S3_SECURE=False
PRESIGNED_URL_EXPIRE_SECONDS=3600

MEDIA_RETENTION_HOURS=24
CLEANUP_INTERVAL_MINUTES=60

DEFAULT_USER_DAILY_QUOTA=50
GUEST_DAILY_QUOTA=5

LAMA_MODEL_PATH=/app/models_weights/big-lama.onnx
MAX_IMAGE_DIMENSION=2048
MAX_FILE_SIZE_MB=50
